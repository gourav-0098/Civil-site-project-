# Environment Configuration Template for Nivara Infrastructure

# System & Runtime
NODE_ENV=development
PORT=5000

# Backend Database
# Local MongoDB or MongoDB Atlas URI:
MONGODB_URI=mongodb://127.0.0.1:27017/nivara_infrastructure

# Express Authentication & Sessions
SESSION_SECRET=change_this_to_a_secure_random_string_in_production_min_32_chars
ALLOWED_ORIGIN=http://localhost:3000

# Cache Revalidation Secret (shared between Express API and Next.js)
REVALIDATION_SECRET=change_this_to_a_secure_revalidation_secret_key

# Admin User Seeding (used during npm run seed:admin)
ADMIN_NAME="Nivara Superadmin"
ADMIN_EMAIL=admin@nivarainfra.com
ADMIN_PASSWORD=NivaraAdmin2026!

# Cloudinary (Direct unsigned/signed uploads and media asset management)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=demo_api_key
CLOUDINARY_API_SECRET=demo_api_secret

# Next.js Frontend Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:5000
NEXT_PUBLIC_API_URL=/api/proxy
